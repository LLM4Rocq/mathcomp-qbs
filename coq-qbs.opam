opam-version: "2.0"
name: "coq-qbs"
version: "dev"
synopsis: "Quasi-Borel Spaces in Rocq"
description: """
A formalization of Quasi-Borel Spaces (QBS) providing a
cartesian-closed category for higher-order probabilistic
programming semantics, built on math-comp analysis.
"""
maintainer: "Guillaume Baudart <guillaume.baudart@inria.fr>"
authors: ["Guillaume Baudart"]
license: "CeCILL-C"
homepage: "https://github.com/LLM4Rocq/mathcomp-qbs"
bug-reports: "https://github.com/LLM4Rocq/mathcomp-qbs/issues"
dev-repo: "git+https://github.com/LLM4Rocq/mathcomp-qbs.git"

depends: [
  "rocq-core" {>= "9.2" & < "9.4~"}
  "rocq-mathcomp-boot" {>= "2.6.0" & < "2.7~"}
  "rocq-mathcomp-algebra" {>= "2.6.0" & < "2.7~"}
  "rocq-mathcomp-analysis" {>= "1.18.0" & < "1.19~"}
  "rocq-hierarchy-builder" {>= "1.10.0"}
  "coq-mathcomp-algebra-tactics"
]

# No algebra-tactics release supports MathComp 2.6 yet: use a master commit
# (its opam file still bounds coq-mathcomp-ssreflect < 2.5, so install with
# OPAMIGNORECONSTRAINTS=coq-mathcomp-ssreflect).
pin-depends: [
  ["coq-mathcomp-algebra-tactics.dev"
   "git+https://github.com/math-comp/algebra-tactics.git#7da689bc90532e70ecf806110fdb4103ba0383b3"]
]

build: [
  ["rocq" "makefile" "-f" "_CoqProject" "-o" "Makefile"]
  [make "-j%{jobs}%"]
]
install: [
  [make "install"]
]
